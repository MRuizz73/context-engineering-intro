# Configuración del correo de la empresa para los recordatorios por email.
# Copiá este archivo a `.env` y completá los datos reales.

# Servidor SMTP de la empresa (para Gmail: smtp.gmail.com con una
# "contraseña de aplicación", no la contraseña normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=empresa@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
SMTP_TLS=1

# Adónde van los avisos de camiones y de choferes sin email cargado.
# Si se omite, se usa SMTP_USER.
EMAIL_ADMIN=oficina@empresa.com

# Cada cuántos días se repite el email de un documento no renovado.
AVISO_EMAIL_CADA_DIAS=7

# Base de datos (opcional; por defecto SQLite local).
# DATABASE_URL=sqlite:///gestion_flota.db
